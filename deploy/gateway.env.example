# Enable only after checking applicable provider terms and polling restrictions.
AEC_POLL_ENABLED=false
AEC_EMAIL=
AEC_PASSWORD=
AEC_SUMMARY_INTERVAL=60
AEC_DETAIL_INTERVAL=300
# Diagnostics heartbeat in seconds; 0 disables periodic reports.
AEC_DIAGNOSTICS_INTERVAL=60
# Full JSON heartbeat in Docker logs; 0 disables.
AEC_DIAGNOSTICS_LOG_INTERVAL=300
AEC_TIMEZONE=Europe/Budapest
# Optional when exactly one inverter is discovered:
AEC_PLANT_ID=
AEC_INVERTER_SN=
MQTT_ENABLED=true
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_TLS=false
MQTT_USERNAME=
MQTT_PASSWORD=
# Unique per running instance; optionally use aec/<inverter serial> locally.
MQTT_TOPIC_PREFIX=aec/inverter
MQTT_CLIENT_ID=aec-gateway

# Optional PostgreSQL snapshot storage.
DB_ENABLED=false
DB_HOST=postgresql
DB_PORT=5432
DB_NAME=aec_gateway
DB_USER=aec_gateway
DB_PASSWORD=
DB_SSLMODE=prefer
# 0 = keep indefinitely; positive = retention in days.
DB_RETENTION_DAYS=0

# Optional Home Assistant MQTT Discovery. Read-only sensors; no control.
HA_DISCOVERY_ENABLED=false
HA_DISCOVERY_REMOVE=false
HA_DISCOVERY_PREFIX=homeassistant
# Leave empty for stable ID derived from MQTT_TOPIC_PREFIX.
HA_DEVICE_ID=
HA_DEVICE_NAME=AEC Inverter
