# Enable only after checking applicable provider terms and polling restrictions.
AEC_POLL_ENABLED=false
AEC_EMAIL=
AEC_PASSWORD=
AEC_SUMMARY_INTERVAL=60
AEC_DETAIL_INTERVAL=300
AEC_TIMEZONE=Europe/Budapest
# Optional when exactly one inverter is discovered:
AEC_PLANT_ID=
AEC_INVERTER_SN=
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_TLS=false
MQTT_USERNAME=
MQTT_PASSWORD=
# Unique per running instance; optionally use aec/<inverter serial> locally.
MQTT_TOPIC_PREFIX=aec/inverter
MQTT_CLIENT_ID=aec-gateway
